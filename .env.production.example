# ---------------------------------------------------------------------------
# Production environment for the Hetzner VM.
#
# Copy this to `.env.production` ON THE SERVER (or scp it up) and fill in real
# values. `.env.production` is gitignored and MUST NEVER be committed.
#
#   cp .env.production.example .env.production   # then edit
#
# docker-compose.prod.yml injects these into the api + worker containers and
# uses POSTGRES_* to init the database. See DEPLOYMENT.md.
# ---------------------------------------------------------------------------

# --- Application ---
APP_ENV=production
APP_PORT=8000
# Generate a fresh one: openssl rand -hex 32   (min 32 chars)
APP_SECRET_KEY=
# The public HTTPS URL of THIS backend (the sslip.io host for the server IP).
APP_PUBLIC_URL=https://api.167-233-172-142.sslip.io

# --- CORS ---
# Comma-separated allowed browser origins = your Vercel frontend URL(s).
# Set this to the real Vercel domain once the FE is deployed.
CORS_ORIGINS=https://REPLACE-WITH-YOUR-PROJECT.vercel.app

# --- Postgres ---
# DATABASE_URL is assembled automatically in docker-compose.prod.yml from these
# three values, so you set the password in ONE place here.
POSTGRES_USER=kabil
POSTGRES_PASSWORD=
POSTGRES_DB=kabil
DATABASE_POOL_SIZE=10

# --- Redis (internal compose service names) ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/3
CELERY_RESULT_BACKEND=redis://redis:6379/4

# --- AI providers  (ROTATE the keys that were previously exposed) ---
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=

# --- Azure Blob (CV storage) — ROTATE ---
AZURE_BLOB_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=kabil-cvs

# --- Email (Brevo HTTP API — reaches any recipient once sender is verified) ---
BREVO_API_KEY=
BREVO_FROM=
BREVO_FROM_NAME=Kabil

# --- WhatsApp (Meta Cloud API) ---
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
META_WA_APP_SECRET=
META_WA_VERIFY_TOKEN=
# Set once Meta approves the cold-invite template (leave blank otherwise).
META_WA_INVITE_TEMPLATE_NAME=

# --- Calendly (interview scheduling — leave disabled until configured) ---
INTERVIEW_SCHEDULING_ENABLED=false
CALENDLY_PERSONAL_ACCESS_TOKEN=
CALENDLY_EVENT_TYPE_URI=
CALENDLY_ORGANIZATION_URI=
CALENDLY_WEBHOOK_SIGNING_KEY=

# --- Tuning (optional; sensible defaults live in code) ---
# SIMILARITY_REJECTION_THRESHOLD=0.4
# DEFAULT_PHONE_REGION=AE
