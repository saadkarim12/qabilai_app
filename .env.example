# Copy to `.env` and fill in real values for local development.
# `.env` is gitignored. Never commit secrets.

# --- Application ---
APP_ENV=development
APP_PORT=8000
APP_SECRET_KEY=replace-with-a-random-string-at-least-32-bytes-long
APP_PUBLIC_URL=http://localhost:8000

# Comma-separated CORS origins
CORS_ORIGINS=http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql+asyncpg://kabil:kabil@localhost:5433/kabil
DATABASE_POOL_SIZE=10

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Celery (required from Step 2.6 onward) ---
CELERY_BROKER_URL=redis://localhost:6379/3
CELERY_RESULT_BACKEND=redis://localhost:6379/4
# Set CELERY_TASK_ALWAYS_EAGER=true to run tasks in-process (tests / local debug).
CELERY_TASK_ALWAYS_EAGER=false

# --- Azure Blob (required from Step 3.2 onward) ---
AZURE_BLOB_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=kabil-cvs

# --- AI providers (required from Step 2.2 / 2.3 onward) ---
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=

# --- WhatsApp (required from Step 5.1 onward) ---
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
META_WA_APP_SECRET=
META_WA_VERIFY_TOKEN=

# --- Google Calendar (required from Step 6.1 onward) ---
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=

# --- Email transport (required from Step 6.4 onward) ---
# Chosen by priority: BREVO_API_KEY → RESEND_API_KEY → SMTP. Use an HTTP
# provider on hosts that block outbound SMTP (Railway filters 25/465/587).
#
# Brevo (preferred): single-sender verification reaches ANY recipient, no
# domain/DNS. Get the key at app.brevo.com → SMTP & API → API Keys (xkeysib-…);
# BREVO_FROM must be a verified sender (your signup email is auto-verified).
BREVO_API_KEY=
BREVO_FROM=
BREVO_FROM_NAME=Kabil

# Resend (alt HTTP): test mode only emails your own account address until you
# verify a domain at resend.com/domains (then set RESEND_FROM to it).
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# SMTP fallback (local MailHog / a relay that allows submission).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@kabil.ai

# --- Calendly (interview scheduling, Step 6.4) ---
# Personal Access Token: Calendly → Integrations → API & Webhooks (needs a paid
# plan with API access). Run `python -m scripts.calendly_setup discover` with
# this set to obtain the URIs below, then `... register --callback-url <url>`
# to create the webhook and obtain the signing key.
CALENDLY_PERSONAL_ACCESS_TOKEN=
CALENDLY_EVENT_TYPE_URI=
CALENDLY_ORGANIZATION_URI=
CALENDLY_WEBHOOK_SIGNING_KEY=
# Master switch — leave false until the four values above are set; while false
# the stage→interview hook is a no-op and POST /webhooks/calendly returns 404.
INTERVIEW_SCHEDULING_ENABLED=false

# --- Tuning ---
SIMILARITY_REJECTION_THRESHOLD=0.4
CV_MAX_FILE_SIZE_MB=10
WHATSAPP_REPLY_TIMEOUT_HOURS=24
INTERVIEW_REPLY_TIMEOUT_HOURS=48
INTERVIEW_REMINDER_HOURS=24
TALENT_POOL_EXPIRY_DAYS=365
